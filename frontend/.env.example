# Where the Next.js rewrite forwards /api/* to
# Local development:
# BACKEND_URL=http://localhost:4000
# Production on Vercel (set in Vercel Project Settings -> Environment Variables):
BACKEND_URL=https://your-backend-api-domain.com

# Show a "Continue as dev user" button on the login page (leave false in production)
NEXT_PUBLIC_DEV_LOGIN=false
